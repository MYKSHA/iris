# ── Brain selection ──────────────────────────────────────────────
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise Nous free tier
IRIS_PROVIDER=auto

# Claude (best quality). Create a key at https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...
# IRIS_CLAUDE_MODEL=claude-opus-5

# Nous Portal (free tier). If unset, Iris reuses the OAuth token that
# Hermes Agent keeps refreshed in %LOCALAPPDATA%\hermes\auth.json.
# NOUS_API_KEY=
# IRIS_NOUS_MODEL=tencent/hy3:free

# ── Telegram gateway ─────────────────────────────────────────────
# Create a bot with @BotFather on Telegram, paste the token here.
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# Comma-separated numeric Telegram user ids allowed to talk to Iris.
# (Message the bot once and it will tell you your id.)
# TELEGRAM_ALLOWED_USERS=

# ── Safety ───────────────────────────────────────────────────────
# 1 = run shell commands without asking for confirmation (needed for
# shell use over Telegram, where there is no interactive prompt).
IRIS_YOLO=0
